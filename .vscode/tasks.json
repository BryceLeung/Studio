{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Studio Dashboard",
      "type": "process",
      "command": "${workspaceFolder}/.venv-tools/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv-tools\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "studio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
